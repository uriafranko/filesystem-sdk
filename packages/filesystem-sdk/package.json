{
  "name": "filesystem-sdk",
  "version": "0.1.0",
  "description": "A POSIX-like virtual filesystem overlay for files-sdk-compatible object storage, with just-bash integration.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uriafranko/filesystem-sdk.git",
    "directory": "packages/filesystem-sdk"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./files-sdk": {
      "types": "./dist/files-sdk/index.d.ts",
      "import": "./dist/files-sdk/index.js"
    },
    "./just-bash": {
      "types": "./dist/just-bash/index.d.ts",
      "import": "./dist/just-bash/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/files-sdk/index.ts src/just-bash/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "files-sdk": ">=0.0.0",
    "just-bash": ">=0.0.0"
  },
  "peerDependenciesMeta": {
    "just-bash": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "files-sdk": "^1.2.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.0.14"
  }
}
